{
    "name"        : "garage",
    "version"     : "0.1.0",
    "description" : "a small http server, router, and middleware toolkit",
    "repository"  : "github:4apaev/garage",
    "type"        : "module",
    "main"        : "./src/index.js",
    "types"       : "./src/types.d.ts",
    "engines": { "node": ">=24" },
    "files"  : [ "src" ],
    "exports": {
        "."           : { "types": "./src/types.d.ts", "default": "./src/index.js"     },
        "./constants" : { "types": "./src/types.d.ts", "default": "./src/constants.js" },
        "./compose"   : { "types": "./src/types.d.ts", "default": "./src/compose.js"   },
        "./garage"    : { "types": "./src/types.d.ts", "default": "./src/garage.js"    },
        "./use"       : { "types": "./src/types.d.ts", "default": "./src/use.js"       },
        "./util"      : { "types": "./src/types.d.ts", "default": "./src/util.js"      },
        "./sync"      : { "types": "./src/types.d.ts", "default": "./src/sync.js"      },
        "./mime"      : { "types": "./src/types.d.ts", "default": "./src/mime.js"       }
    },
    "scripts": {
        "test": "node --experimental-test-coverage --test ./test/*.spec.js",
        "lint": "eslint .",
        "tchk": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js" : "^10.0.1",
        "@types/node": "^26.2.0",
        "eslint"     : "^10.9.0",
        "globals"    : "^17.11.0",
        "typescript" : "^7.0.2"
    }
}
